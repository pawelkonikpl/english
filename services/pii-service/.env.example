# Detector backend: bardsai-eu-pii (default), openai-privacy-filter, regex
PII_BACKEND=bardsai-eu-pii

# Optional: replace the backend's default Hugging Face model and pin its revision
# PII_MODEL_ID=bardsai/eu-pii-anonimization-multilang-v3
# PII_MODEL_REVISION=main

# Torch device: cpu or cuda
PII_DEVICE=cpu

# Default confidence threshold (0-1); requests can override it with min_score
PII_MIN_SCORE=0.5

# Long texts are split into overlapping windows of this many tokens
PII_WINDOW_TOKENS=512
PII_WINDOW_STRIDE=128
PII_BATCH_SIZE=8
