# Copy to .env and adjust. Every value has a sensible default.

# --- LLM: provider -------------------------------------------------------
# claude_code = Claude Code subscription (claude-agent-sdk)
# copilot     = GitHub Copilot subscription (github-copilot-sdk)
# fake        = sample answers, no AI (tests, offline, UI demo)
LLM_PROVIDER=claude_code
LLM_TIMEOUT_SECONDS=90

# --- LLM: models ---------------------------------------------------------
# MAIN = conversation, lessons; FAST = hints, sentence checks, explanations.
# Empty value = provider default. Empty *_FAST = same model as MAIN.
# Models can also be changed in the app: Settings -> AI model.
CLAUDE_CODE_MODEL=claude-opus-5-5
CLAUDE_CODE_MODEL_FAST=claude-haiku-5-5
# Models offered in the settings screen (Claude Code cannot list them itself).
CLAUDE_CODE_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
COPILOT_MODEL=
COPILOT_MODEL_FAST=

# --- LLM: optional paths and auth ---------------------------------------
# CLAUDE_CODE_CLI_PATH=/path/to/claude
# Copilot reads these itself: COPILOT_CLI_PATH, COPILOT_GITHUB_TOKEN

# --- App -------------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/english.db   (default: data/english.db)
# Comma-separated; empty = all modules.
ENABLED_MODULES=
APP_TIMEZONE=Europe/Warsaw
DAILY_NEW_PHRASES=10
HOST=127.0.0.1
PORT=8000
